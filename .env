# Example .env file for Vite projects
# Copy this file to .env in your project root and customize the values

# Kiosk identification
VITE_KIOSK_ID=KIOSK_001

# Video recording duration in milliseconds
# 5000 = 5 seconds, 7000 = 7 seconds
VITE_VIDEO_DURATION=2000

# API Base URL (optional - defaults to config.js value)
# VITE_API_BASE_URL=http://127.0.0.1:8000

# ========================================
# PORT CONFIGURATION
# ========================================

# Height Sensor Port (port index 0)
# Can be set to auto-detect or specify a path
# VITE_HEIGHT_PORT_PATH=/dev/ttyUSB0
VITE_HEIGHT_PORT_INDEX=1

# BIA/Weight Sensor Port (port index 2)
# Can be set to auto-detect or specify a path
# VITE_BIA_PORT_PATH=/dev/ttyACM0
VITE_BIA_PORT_INDEX=0

# Serial Port Configuration
VITE_SERIAL_BAUD_RATE=9600
VITE_SERIAL_DATA_BITS=8
VITE_SERIAL_STOP_BITS=1
VITE_SERIAL_PARITY=none

# Port Connection Timeouts (milliseconds)
VITE_PORT_CONNECT_TIMEOUT=5000
VITE_PORT_READ_TIMEOUT=10000

# Measurement Timeouts (milliseconds)
VITE_WEIGHT_MEASUREMENT_TIMEOUT=6000
VITE_HEIGHT_MEASUREMENT_TIMEOUT=10000
VITE_LEG_IMPEDANCE_TIMEOUT=15000
VITE_ARM_IMPEDANCE_TIMEOUT=15000
VITE_IMPEDANCE_20KHZ_TIMEOUT=20000
VITE_IMPEDANCE_100KHZ_TIMEOUT=20000

# ========================================
# PORT CONFIGURATION
# ========================================

# Serial Port Configuration
VITE_SERIAL_BAUD_RATE=9600
VITE_SERIAL_DATA_BITS=8
VITE_SERIAL_STOP_BITS=1
VITE_SERIAL_PARITY=none

# Port Connection Timeouts (milliseconds)
VITE_PORT_CONNECT_TIMEOUT=5000
VITE_PORT_READ_TIMEOUT=10000

# Measurement Timeouts (milliseconds)
VITE_WEIGHT_MEASUREMENT_TIMEOUT=6000
VITE_HEIGHT_MEASUREMENT_TIMEOUT=10000
VITE_LEG_IMPEDANCE_TIMEOUT=15000
VITE_ARM_IMPEDANCE_TIMEOUT=15000
VITE_IMPEDANCE_20KHZ_TIMEOUT=20000
VITE_IMPEDANCE_100KHZ_TIMEOUT=20000