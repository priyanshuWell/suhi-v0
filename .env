# Example .env file for Vite projects
# Copy this file to .env in your project root and customize the values

# Kiosk identification
VITE_KIOSK_ID=KIOSK_001

# Video recording duration in milliseconds
# 5000 = 5 seconds, 7000 = 7 seconds
VITE_VIDEO_DURATION=5000

# API Base URL (optional - defaults to config.js value)
# VITE_API_BASE_URL=http://127.0.0.1:8000